<section>
    <figure>
        <img class="noborder" src="modules/pixels/ui/pixels-logo.webp" width="437" height="170"
             alt="{{ localize "PIXELS.CONFIG.Logo" }}">
    </figure>

    {{#if hasDevices}}
    <section class="devices">
        <h2>{{ localize "PIXELS.CONFIG.KnownDice" }} <span class="dice-count">{{ connectedCount }}/{{ totalCount }}</span></h2>
        {{#each devices}}
        <div class="pixel flexrow {{ cssClass }}" data-pixel-id="{{ pixelId }}">
            <span class="pixel-status {{ statusClass }}" title="{{ statusLabel }}"></span>
            <i class="{{ denominationIcon }} pixel-die-icon"></i>
            <h3>{{ name }} <span class="denomination">({{ denomination }})</span></h3>
            {{#if battery}}
            <span class="battery"><i class="fa-solid fa-battery-full"></i> {{ battery }}%</span>
            {{/if}}
            {{#unless active}}
            <button type="button" class="pixel-btn reconnect" data-action="reconnectPixel"
                    data-tooltip="{{ localize "PIXELS.CONFIG.ACTIONS.Reconnect" }}"
                    aria-label="{{ localize "PIXELS.CONFIG.ACTIONS.Reconnect" }}">
                <i class="fa-solid fa-bluetooth"></i> {{ localize "PIXELS.CONFIG.ACTIONS.Reconnect" }}
            </button>
            {{/unless}}
            <button type="button" class="pixel-btn forget" data-action="forgetPixel"
                    data-tooltip="{{ disconnectTooltip }}"
                    aria-label="{{ disconnectTooltip }}">
                <i class="fa-solid fa-times"></i>
            </button>
        </div>
        {{/each}}
    </section>

    {{else}}
    <p>{{ localize "PIXELS.CONFIG.NoPixels" }}</p>
    {{/if}}

    <footer class="flexrow">
        <button type="button" data-action="requestPixel">
            <i class="fa-solid fa-plus"></i>
            <span>{{ localize "PIXELS.CONFIG.ACTIONS.Add" }}</span>
        </button>
    </footer>
</section>
